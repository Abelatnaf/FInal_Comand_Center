NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Due-bill push reminders (optional) ---------------------------------
# Everything below is only needed if you want reminders to reach a phone
# when the app is closed. Without them the app works exactly as before and
# the cron route reports a no-op instead of failing.
#
# Generate the pair with:  npx web-push generate-vapid-keys
# The public key goes in BOTH variables -- the browser needs it to subscribe,
# and the server needs it to sign. The private key is server-only.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address for the push service, per the Web Push spec.
VAPID_SUBJECT=mailto:you@example.com

# Lets the cron route read every user's due bills. Server-only, never
# expose this to a browser.
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron sends this as a bearer token; without it the route is open.
CRON_SECRET=
